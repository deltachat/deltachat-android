<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/position_indicator_container"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">
    </LinearLayout>

    <org.thoughtcrime.securesms.components.CircleColorImageView
        android:id="@+id/file_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:scaleType="center"
        android:src="@drawable/ic_insert_drive_file_white_24dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible"
        app:circleColor="@color/document_icon" />

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/msg_text"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="35dp"
        style="@style/Signal.Text.Preview"
        tools:text="With great power comes great responsibility." />

    <ImageView
        android:id="@+id/pin_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pin_24"
        android:tint="?icon_tint"
        android:visibility="visible" />

    <Button
        android:id="@+id/open_app_btn"
        android:visibility="gone"
        style="@style/ButtonPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:padding="@dimen/message_bubble_showmore_padding"
        android:minHeight="1dp"
        android:minWidth="64dp"
        android:text="@string/start_app"
        android:textAllCaps="false" />

</LinearLayout>
