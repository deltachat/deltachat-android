<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:viewBindingIgnore="true"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:minWidth="70dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:gravity="center">

    <!-- android:textColor is set to avoid default transparency making emoji transparent -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/reaction_pill_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="?attr/emoji_text_color"
        android:textSize="16sp"
        tools:text="👍" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/reaction_pill_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/reaction_pill_text_color"
        tools:text="23" />

</LinearLayout>
